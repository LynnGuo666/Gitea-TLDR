# Gitea配置
GITEA_URL=https://gitea.example.com
GITEA_TOKEN=your_gitea_access_token_here

# Webhook配置（可选）
WEBHOOK_SECRET=your_webhook_secret_here

# Claude Code 配置（legacy，仅当 ENABLE_LEGACY_PROVIDERS=true 时生效）
# CLAUDE_CODE_PATH=claude
# 以下两项为启动默认值；启动后可在管理后台 /admin/config 热改，无需重启
# CLAUDE_USAGE_PROXY_ENABLED=true
# CLAUDE_USAGE_PROXY_DEBUG=false
# 当使用 legacy CLI provider 时，需要为其指定 Anthropic 上游
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here

# 默认审查引擎提供者（启动默认值；可在 /admin/config 热改）
DEFAULT_PROVIDER=forge

# 是否启用 legacy CLI providers（claude_code / codex_cli）。
# 默认关闭——仅 Forge 引擎在 registry 中注册。设为 true 时按需加载 CLI provider。
# 注意：默认 Docker 镜像（runtime target）不含 nodejs 与 CLI 二进制，镜像更小。
# 启用 legacy provider 需改用 runtime-with-legacy target 构建镜像：
#   docker build -f docker/Dockerfile --target runtime-with-legacy -t gitea-tldr:legacy .
ENABLE_LEGACY_PROVIDERS=false

# Codex CLI 配置（legacy，仅当 ENABLE_LEGACY_PROVIDERS=true 时生效）
# CODEX_CLI_PATH=codex
# CODEX_API_KEY=your_codex_api_key_here

# Forge 引擎配置（可选，使用 Forge 作为审查引擎时配置，无需安装 CLI）
# FORGE_BASE_URL=https://api.anthropic.com
# FORGE_API_KEY=your_anthropic_api_key_here
# FORGE_MODEL=claude-sonnet-4-20250514
# FORGE_MAX_TURNS=5

# 工作目录配置（默认使用项目目录下的 review-workspace）
# WORK_DIR=./review-workspace

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 日志配置
LOG_LEVEL=INFO

# Debug模式（设置为true开启详细日志输出，包括所有API请求和响应）
DEBUG=false

# 以下字段为启动默认值；启动后均可在管理后台 /admin/config 热改，无需重启
# Bot配置（可选，用于识别评论中的@提及）
# BOT_USERNAME=pr-reviewer-bot

# 审查配置（默认值，可选）
# DEFAULT_REVIEW_FOCUS=quality,security,performance,logic

# 自动请求审查者（默认为true，创建review后自动将bot设置为审查者）
AUTO_REQUEST_REVIEWER=true

# OAuth登录（可选）
# OAUTH_CLIENT_ID=your_client_id
# OAUTH_CLIENT_SECRET=your_client_secret
# OAUTH_REDIRECT_URL=http://localhost:8000/api/auth/callback
# OAUTH_SCOPES=read:user,write:repository
# SESSION_COOKIE_NAME=gitea_session
# SESSION_COOKIE_SECURE=false

# 管理后台（可选）
# ADMIN_ENABLED=true
# INITIAL_ADMIN_USERNAME=admin
# 以下两项为日志清理默认值；可在 /admin/config 热改
# WEBHOOK_LOG_RETENTION_DAYS=30
# WEBHOOK_LOG_RETENTION_DAYS_FAILED=90
